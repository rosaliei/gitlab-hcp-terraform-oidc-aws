# Managed by ansible (site.yml)
user www-data;
worker_processes auto;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;

events {
  worker_connections 1024;
}

# ---------------------------------------------------------------------------
# TCP: RKE2 API (6443) and join (9345) -> masters
# ---------------------------------------------------------------------------
stream {
  upstream rke2_api {
{% for host in groups['masters'] %}
    server {{ hostvars[host].ansible_host }}:6443;
{% endfor %}
  }

  upstream rke2_register {
{% for host in groups['masters'] %}
    server {{ hostvars[host].ansible_host }}:9345;
{% endfor %}
  }

  server { listen 6443; proxy_pass rke2_api; }
  server { listen 9345; proxy_pass rke2_register; }
}

# ---------------------------------------------------------------------------
# HTTP/HTTPS: nginx does TLS (Let's Encrypt), then sends plain HTTP to ingress
# ---------------------------------------------------------------------------
http {
  upstream ingress {
{% for host in groups['k8s_cluster'] %}
    server {{ hostvars[host].ansible_host }}:80;
{% endfor %}
  }

  # needed for websockets (Rancher UI uses them)
  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  # http -> https
  server {
    listen 80;
    server_name {{ domain }};
    return 301 https://$host$request_uri;
  }

  server {
    listen 443 ssl;
    server_name {{ domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;

    location / {
      proxy_pass http://ingress;
      proxy_http_version 1.1;
      proxy_set_header Host              $host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header Upgrade           $http_upgrade;
      proxy_set_header Connection        $connection_upgrade;
      proxy_read_timeout 900s;
    }
  }
}
