# Managed by ansible (site.yml)
user www-data;
worker_processes auto;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;

events {
  worker_connections 1024;
}

# ---------------------------------------------------------------------------
# TCP passthrough -> masters
#   6443 = Kubernetes API (api.kst-devops.com:6443, TLS is done by the API server)
#   9345 = RKE2 join
# ---------------------------------------------------------------------------
stream {
  upstream rke2_api {
{% for host in groups['masters'] %}
    server {{ hostvars[host].ansible_host }}:6443;
{% endfor %}
  }

  upstream rke2_register {
{% for host in groups['masters'] %}
    server {{ hostvars[host].ansible_host }}:9345;
{% endfor %}
  }

  server { listen 6443; proxy_pass rke2_api; }
  server { listen 9345; proxy_pass rke2_register; }
}

# ---------------------------------------------------------------------------
# HTTPS: nginx does TLS (wildcard Let's Encrypt cert), then plain http inside
#   rancher.kst-devops.com          -> ingress-nginx          (nodes :80)
#   argocd / oia.kst-devops.com     -> istio ingress gateway  (nodes :30080)
# ---------------------------------------------------------------------------
http {
  upstream ingress_nginx {
{% for host in groups['k8s_cluster'] %}
    server {{ hostvars[host].ansible_host }}:80;
{% endfor %}
  }

  upstream istio_gateway {
{% for host in groups['k8s_cluster'] %}
    server {{ hostvars[host].ansible_host }}:30080;
{% endfor %}
  }

  # needed for websockets (Rancher / Argo CD UI)
  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  ssl_certificate     /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;

  proxy_http_version 1.1;
  proxy_set_header Host              $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header Upgrade           $http_upgrade;
  proxy_set_header Connection        $connection_upgrade;
  proxy_read_timeout 900s;

  # http -> https
  server {
    listen 80;
    server_name {{ domain }} *.{{ domain }};
    return 301 https://$host$request_uri;
  }

  server {
    listen 443 ssl;
    server_name rancher.{{ domain }};
    location / { proxy_pass http://ingress_nginx; }
  }

  server {
    listen 443 ssl;
    server_name argocd.{{ domain }} oia.{{ domain }};
    location / { proxy_pass http://istio_gateway; }
  }
}
